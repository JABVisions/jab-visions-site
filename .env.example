# Supabase Dashboard -> Project Settings -> API (or the project's Connect dialog)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Paste either the legacy anon key or the modern sb_publishable_ key here.
# Never place a service_role or sb_secret_ key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Visionary AI (server-only; never prefix this key with NEXT_PUBLIC_)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini

# LiveKit Cloud — server-only credentials from your LiveKit project settings.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
