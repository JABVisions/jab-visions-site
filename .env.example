# Supabase Dashboard -> Project Settings -> API (or the project's Connect dialog)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Paste either the legacy anon key or the modern sb_publishable_ key here.
# Never place a service_role or sb_secret_ key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Visionary AI (server-only; never prefix this key with NEXT_PUBLIC_)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini

# Pay Drops (server-only; never prefix these keys with NEXT_PUBLIC_)
STRIPE_SECRET_KEY=rk_test_YOUR_RESTRICTED_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SIGNING_SECRET
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Basis points retained by Board: 1000 = 10%, 500 = 5%, 0 = beta/no fee.
# When set below Stripe processing costs, Board absorbs the difference.
BOARD_PLATFORM_FEE_BPS=0
BOARD_STRIPE_DEFAULT_COUNTRY=us
